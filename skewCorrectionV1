def fit_plane(xyz: np.ndarray):
    """Fits a plane of form z = ax + by + c."""
    X = np.c_[xyz[:, 0], xyz[:, 1], np.ones(len(xyz))]
    y = xyz[:, 2]
    return np.linalg.lstsq(X, y, rcond=None)[0]

# ----------(NEW) Fit plane through 3 points only-------- #
def fit_plane_3pts(points: np.ndarray):
    """
    Returns a, b, c coefficients so z = ax + by + c, from 3 points.
    """
    p1, p2, p3 = points
    # Find plane normal
    v1 = p2 - p1
    v2 = p3 - p1
    n = np.cross(v1, v2)
    if np.isclose(n[2], 0):
        raise ValueError("Degenerate normal: Z component is zero")
    # Plane: n[0](x-x1) + n[1](y-y1) + n[2](z-z1) = 0
    # Solve for z = ax + by + c
    a = -n[0]/n[2]
    b = -n[1]/n[2]
    c = (np.dot(n, p1) - n[0]*p1[0] - n[1]*p1[1]) / n[2]
    return a, b, c

