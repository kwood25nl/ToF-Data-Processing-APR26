def cap_and_export_stl(ply_path, stl_path):
    o3d_mesh = o3d.io.read_triangle_mesh(ply_path)
    o3d_mesh.compute_vertex_normals()

    tm = trimesh.Trimesh(
        vertices=np.asarray(o3d_mesh.vertices),
        faces=np.asarray(o3d_mesh.triangles),
        process=False
    )

    print(f"Watertight before capping: {tm.is_watertight}")
    closed = cap_open_bottom(tm)
    print(f"Watertight after  capping: {closed.is_watertight}")

    closed.export(stl_path)
    print("Saved STL:", stl_path)

def save_mesh_3d_html(mesh: o3d.geometry.TriangleMesh, path: str):
    """
    Export an interactive, orbitable 3D mesh viewer as a self-contained HTML
    file using Plotly's Mesh3d trace.

    Vertices are coloured by Z height (Viridis colorscale) so surface
    topology is immediately readable.  Lighting is set to give a sense of
    depth without hiding fine detail.  Orbit, pan, and zoom all work with
    the mouse out-of-the-box.
    """
    verts = np.asarray(mesh.vertices).copy()
    faces = np.asarray(mesh.triangles).copy()

    # Force Z floor to exactly 0.0 — cut_mesh_at_z can leave a small residual
    verts[:, 2] -= verts[:, 2].min()

    x, y, z = verts[:, 0], verts[:, 1], verts[:, 2]
    i, j, k = faces[:, 0], faces[:, 1], faces[:, 2]

    # Axis ranges for a balanced aspect ratio
    x_range = (x.max() - x.min()) or 1.0
    y_range = (y.max() - y.min()) or 1.0
    z_range = (z.max() - z.min()) or 1.0
    xy_max = max(x_range, y_range)

    fig = go.Figure(data=[go.Mesh3d(
        x=x, y=y, z=z,
        i=i, j=j, k=k,
        intensity=z,  # colour by height
        colorscale="Viridis",
        colorbar=dict(title="Z (mm)", thickness=15, len=0.6),
        flatshading=False,
        lighting=dict(
            ambient=0.5,
            diffuse=0.8,
            specular=0.2,
            roughness=0.5,
            fresnel=0.1,
        ),
        lightposition=dict(x=1, y=1, z=2),
        showscale=True,
        name="Corrected Mesh",
    )])

    fig.update_layout(
        title=dict(
            text="Corrected Mesh – Interactive 3D Viewer (orbit / pan / zoom with mouse)",
            font=dict(size=14),
        ),
        scene=dict(
            xaxis_title="X (mm)",
            yaxis_title="Y (mm)",
            zaxis_title="Z (mm)",
            aspectmode="manual",
            aspectratio=dict(
                x=x_range / xy_max,
                y=y_range / xy_max,
                z=z_range / xy_max,
            ),
            camera=dict(
                eye=dict(x=1.5, y=-1.5, z=1.2),  # sensible default orbit angle
            ),
        ),
        margin=dict(l=0, r=0, t=50, b=0),
    )

    fig.write_html(path, include_plotlyjs="cdn", full_html=True)
    print("Saved HTML:", path)

def project_and_merge_base_vertices_to_z0(verts, tris, z_epsilon=1e-5, xy_epsilon=1e-5):
    """
    Project all vertices within z_epsilon of z=0 to z=0,
    then merge all (x,y,0) vertices within xy_epsilon to single unique verts.
    Returns (new_verts, new_tris)
    """
    import numpy as np
    try:
        from scipy.spatial import cKDTree
    except ImportError:
        from scipy.spatial import KDTree as cKDTree

    verts = np.asarray(verts)
    tris = np.asarray(tris)

    # 1. Snap all vertices close to z=0 onto z=0
    near_base = np.abs(verts[:, 2]) < z_epsilon
    verts[near_base, 2] = 0.0

    # 2. Find all exactly z=0 verts
    is_base = np.abs(verts[:, 2]) < z_epsilon
    base_indices = np.where(is_base)[0]
    xy_base = verts[base_indices, :2]

    # 3. Merge (x, y, 0) verts within xy_epsilon using a KD-tree
    to_keep = np.ones(len(base_indices), dtype=bool)
    xy_tree = cKDTree(xy_base)
    mapping = np.arange(len(verts))
    for j, idx in enumerate(base_indices):
        if not to_keep[j]:
            continue
        nearby = xy_tree.query_ball_point(xy_base[j], r=xy_epsilon)
        for n in nearby:
            if n != j:
                to_keep[n] = False
                mapping[base_indices[n]] = idx  # Map duplicates to representative

    # Build mapping: old vertex idx → new compacted idx
    keep_indices = np.setdiff1d(np.arange(len(verts)), base_indices[~to_keep])
    mapping_lookup = np.zeros(len(verts), dtype=int)
    new_verts_list = []
    for new_idx, old_idx in enumerate(keep_indices):
        mapping_lookup[old_idx] = new_idx
        new_verts_list.append(verts[old_idx])
    for i, idx in enumerate(base_indices):
        if to_keep[i]:
            continue  # already in keep_indices
        mapping_lookup[idx] = mapping[idx]
    new_verts = np.array(new_verts_list)

    # Update triangles
    new_tris = mapping_lookup[tris]

    # Filter degenerate triangles (collapsed after merge)
    keep = np.array([len(set(t)) == 3 for t in new_tris])
    new_tris = new_tris[keep]
    print(f"[project_and_merge_base_vertices_to_z0] Reduced base verts {len(base_indices)} → {np.sum(to_keep)}. All degenerate triangles removed.")
    return new_verts, new_tris

