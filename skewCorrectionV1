def main():

    # --------------- STEP 1: LOAD MESH ---------------
    mesh = o3d.io.read_triangle_mesh(INPUT_PLY)
    if len(mesh.vertices) == 0 or len(mesh.triangles) == 0:
        raise RuntimeError("Input mesh is empty or invalid")
    print(f"Loaded mesh: {len(mesh.vertices)} vertices, {len(mesh.triangles)} faces")

    # --------------- STEP 2: PLANE SELECTION ---------------
    if not USE_AUTOMATIC_FLOOR_DETECTION:
        print("\nManual mode: Pick 3 points for the floor plane (SHIFT+LEFT CLICK on vertex, close window when done).")
        pcd = o3d.geometry.PointCloud()
        pcd.points = mesh.vertices
        vis = o3d.visualization.VisualizerWithEditing()
        vis.create_window(window_name='Pick 3 floor plane points')
        render_option = vis.get_render_option()
        render_option.background_color = np.asarray([1, 1, 1])
        vis.add_geometry(pcd)
        vis.run()
        vis.destroy_window()
        picked_indices = vis.get_picked_points()
        print("Picked indices:", picked_indices)

        if len(picked_indices) != 3:
            print("ERROR: Pick exactly 3 points! Rerun and pick again.")
            return
        points = np.asarray(pcd.points)[picked_indices]
        print("Picked coordinates for plane fit:\n", points)

        a, b, c = fit_plane_3pts(points)
        print(f"Floor plane (manual): z = {a:.6f}x + {b:.6f}y + {c:.6f}")

    else:
        print("Automatic floor detection...")
        object_mask = detect_floor_boundary(np.asarray(mesh.vertices), GRID_RES)
        verts = np.asarray(mesh.vertices)
        a, b, c = fit_plane(verts[~object_mask])
        print(f"Floor plane (auto): z = {a:.6f}x + {b:.6f}y + {c:.6f}")

    # --------------- STEP 3: DESKEW/SUBTRACT PLANE ---------------
    verts = np.asarray(mesh.vertices)
    z_plane = a * verts[:, 0] + b * verts[:, 1] + (c - SHIFT)
    verts[:, 2] = verts[:, 2] - z_plane
    mesh.vertices = o3d.utility.Vector3dVector(verts)

    # --------------- STEP 4: EXPORT INTERMEDIATE DESKEWED MESH ---------------
    DESKEWED_PLY = os.path.join(OUTPUT_DIR, "Deskewed_for_manual_edit.ply")
    o3d.io.write_triangle_mesh(DESKEWED_PLY, mesh)
    print("\nSaved deskewed mesh for further (optional) crop/repair to:")
    print(DESKEWED_PLY)
    print("Edit this mesh (crop/fix/weld/add-walls etc) and supply path to edited mesh (.ply) below.\n"
          "(Press Enter to skip editing & use deskewed mesh for output)")

    # --------------- STEP 5: USER LOADS MANUALLY EDITED MESH OR CONTINUES ---------------
    edited_ply_path = input("Enter the path to your EDITED/CLEANED mesh (.ply), or press Enter to use deskewed: ").strip()
    if edited_ply_path == "":
        edited_ply_path = DESKEWED_PLY
    assert os.path.isfile(edited_ply_path), f"File not found: {edited_ply_path}"

    mesh = o3d.io.read_triangle_mesh(edited_ply_path)
    assert len(mesh.vertices) > 0 and len(mesh.triangles) > 0, "Empty mesh"
    verts = np.asarray(mesh.vertices)
    tris = np.asarray(mesh.triangles)

    # --------------- STEP 6: SHIFT UPWARD SO BASE IS AT WALL_DELTA_Z ---------------
    min_z = verts[:, 2].min()
    shift_up = WALL_DELTA_Z - min_z
    verts[:, 2] += shift_up
    mesh.vertices = o3d.utility.Vector3dVector(verts)

    # --------------- STEP 7: PROJECT BOUNDARY WALLS TO Z=0 ---------------
    # Find boundary edges
    tri_edge_set = set()
    for tri in tris:
        for ei in [(0,1), (1,2), (2,0)]:
            e = tuple(sorted([tri[ei[0]], tri[ei[1]]]))
            if e in tri_edge_set:
                tri_edge_set.remove(e)
            else:
                tri_edge_set.add(e)
    boundary_edges = list(tri_edge_set)
    boundary_vert_ids = list(sorted(set([vid for e in boundary_edges for vid in e])))

    # Order boundary loop
    conn = defaultdict(list)
    for a, b in boundary_edges:
        conn[a].append(b)
        conn[b].append(a)
    loop = []
    vid_start = boundary_edges[0][0]
    prev, curr = None, vid_start
    for _ in range(len(boundary_edges) + 5):
        loop.append(curr)
        n = [v for v in conn[curr] if v != prev]
        if not n:
            break
        prev, curr = curr, n[0]
        if curr == vid_start:
            break
    if loop[0] != loop[-1]:
        loop.append(loop[0])
    loop = np.array(loop)

    # Project boundary vertices to Z=0 for wall base
    verts_top = verts[loop, :]
    verts_bot = verts_top.copy()
    verts_bot[:, 2] = 0

    verts_new = np.vstack([verts, verts_bot])

    # For each edge in loop, add 2 wall triangles
    wall_tris = []
    n_boundary = len(loop) - 1
    n_orig = verts.shape[0]
    for i in range(n_boundary):
        v0 = loop[i]
        v1 = loop[i + 1]
        b0 = n_orig + i
        b1 = n_orig + i + 1
        wall_tris.append([v0, v1, b1])
        wall_tris.append([v0, b1, b0])

    tris_new = np.vstack([tris, np.array(wall_tris, dtype=np.int32)])

    # ---- STEP 7B: ROBUST BASE SNAP AND MERGE ----
    verts_final, tris_final = project_and_merge_base_vertices_to_z0(
        verts_new, tris_new,
        z_epsilon=1e-5, xy_epsilon=1e-5
    )

    # ---- Proceed with trimesh capping/export ----
    import trimesh
    tm = trimesh.Trimesh(vertices=verts_final, faces=tris_final, process=False)
    print(f"Boundaries before capping: open edges: {(hasattr(tm,'edges_boundary') and len(getattr(tm,'edges_boundary', []))) or 'N/A'}")

    closed = cap_open_bottom(tm)
    if not closed.is_watertight:
        print("Trying fill_holes() for watertight cap...")
        closed = closed.fill_holes()
    FINAL_OUTPUT_PLY = os.path.join(OUTPUT_DIR, "Final_CorrectedMesh.ply")
    FINAL_OUTPUT_STL = os.path.join(OUTPUT_DIR, "Final_CorrectedMesh.stl")
    FINAL_OUTPUT_HTML = os.path.join(OUTPUT_DIR, "Final_CorrectedMesh_3D.html")
    closed.export(FINAL_OUTPUT_PLY)
    closed.export(FINAL_OUTPUT_STL)

    # For HTML
    mesh_final = o3d.geometry.TriangleMesh()
    mesh_final.vertices = o3d.utility.Vector3dVector(closed.vertices)
    mesh_final.triangles = o3d.utility.Vector3iVector(closed.faces)
    mesh_final.compute_vertex_normals()
    save_mesh_3d_html(mesh_final, FINAL_OUTPUT_HTML)

    print(f"\nAll outputs exported:\nPLY: {FINAL_OUTPUT_PLY}\nSTL: {FINAL_OUTPUT_STL}\nHTML: {FINAL_OUTPUT_HTML}")
    print(f"(Walls project from mesh base at z={WALL_DELTA_Z} down to z=0; wall height is {WALL_DELTA_Z} mm and the mesh is capped and watertight.)\n")
if __name__ == "__main__":
    main()
