# GEOMETRY UTILITIES
# ============================================================

def fit_plane(xyz: np.ndarray):
    """Fits a plane of form z = ax + by + c."""
    X = np.c_[xyz[:, 0], xyz[:, 1], np.ones(len(xyz))]
    y = xyz[:, 2]
    return np.linalg.lstsq(X, y, rcond=None)[0]


def cut_mesh_at_z(mesh: o3d.geometry.TriangleMesh, z_cut: float):
    """
    Cuts mesh at Z = z_cut and removes geometry above that height.
    Leaves an open (uncapped) flat bottom.
    """
    vertices = np.asarray(mesh.vertices)
    triangles = np.asarray(mesh.triangles)

    new_vertices = vertices.tolist()
    new_triangles = []

    def intersect(v1, v2):
        t = (z_cut - v1[2]) / (v2[2] - v1[2])
        return v1 + t * (v2 - v1)

    for tri in triangles:
        pts = vertices[tri]
        above = pts[:, 2] >= z_cut

        if np.all(above):
            new_triangles.append(tri.tolist())

        elif np.any(above):
            kept = pts[above]
            cut = pts[~above]

            if len(kept) == 1:
                v0 = kept[0]
                v1 = intersect(v0, cut[0])
                v2 = intersect(v0, cut[1])

                i0 = new_vertices.index(v0.tolist())
                i1 = len(new_vertices); new_vertices.append(v1.tolist())
                i2 = len(new_vertices); new_vertices.append(v2.tolist())

                new_triangles.append([i0, i1, i2])

            elif len(kept) == 2:
                v0, v1 = kept
                v2 = intersect(v0, cut[0])
                v3 = intersect(v1, cut[0])

                i0 = new_vertices.index(v0.tolist())
                i1 = new_vertices.index(v1.tolist())
                i2 = len(new_vertices); new_vertices.append(v2.tolist())
                i3 = len(new_vertices); new_vertices.append(v3.tolist())

                new_triangles.extend([
                    [i0, i1, i2],
                    [i1, i3, i2],
                ])

    clipped = o3d.geometry.TriangleMesh(
        vertices=o3d.utility.Vector3dVector(np.array(new_vertices)),
        triangles=o3d.utility.Vector3iVector(np.array(new_triangles))
    )

    clipped.remove_duplicated_vertices()
    clipped.remove_duplicated_triangles()
    clipped.remove_degenerate_triangles()
    clipped.compute_vertex_normals()

    return clipped


def cap_open_bottom(mesh: trimesh.Trimesh) -> trimesh.Trimesh:
    """
    Caps the lowest open boundary loop to make the mesh watertight.
    """
    boundary_edges = mesh.edges[
        trimesh.grouping.group_rows(mesh.edges_sorted, require_count=1)
    ]

    if len(boundary_edges) == 0:
        return mesh

    boundary_z = np.array([mesh.vertices[v][2] for e in boundary_edges for v in e])
    bottom_z = np.median(boundary_z)
    z_tol = (boundary_z.max() - boundary_z.min()) * 0.1 + 1e-6

    bottom_edges = [
        e for e in boundary_edges
        if abs(mesh.vertices[e[0]][2] - bottom_z) < z_tol
        and abs(mesh.vertices[e[1]][2] - bottom_z) < z_tol
    ]

    if not bottom_edges:
        return mesh

    bottom_vert_ids = set(v for e in bottom_edges for v in e)
    vertices = mesh.vertices.copy()
    for vid in bottom_vert_ids:
        vertices[vid][2] = bottom_z

    mesh = trimesh.Trimesh(vertices, mesh.faces, process=False)

    edge_map = {}
    for a, b in bottom_edges:
        edge_map.setdefault(a, []).append(b)
        edge_map.setdefault(b, []).append(a)

    start = next(iter(edge_map))
    loop = [start]
    prev, cur = None, start

    while True:
        nxt = next((n for n in edge_map[cur] if n != prev), None)
        if nxt is None or nxt == start:
            break
        loop.append(nxt)
        prev, cur = cur, nxt

    if len(loop) < 3:
        return mesh

    loop_verts = mesh.vertices[loop]
    centroid = loop_verts.mean(axis=0)
    centroid[2] = bottom_z

    new_vertices = np.vstack([mesh.vertices, centroid])
    center_idx = len(mesh.vertices)

    cap_faces = []
    for i in range(len(loop)):
        a, b = loop[i], loop[(i + 1) % len(loop)]
        normal = np.cross(new_vertices[a] - centroid, new_vertices[b] - centroid)[2]
        cap_faces.append(
            [center_idx, a, b] if normal > 0 else [center_idx, b, a]
        )

    closed = trimesh.Trimesh(
        vertices=new_vertices,
        faces=np.vstack([mesh.faces, cap_faces]),
        process=True
    )

    return closed


# ============================================================
# 3D HTML VIEWER
# ============================================================

def save_mesh_3d_html(mesh: o3d.geometry.TriangleMesh, path: str):
    """
    Export an interactive, orbitable 3D mesh viewer as a self-contained HTML
    file using Plotly's Mesh3d trace.

    Vertices are coloured by Z height (Viridis colorscale) so surface
    topology is immediately readable.  Lighting is set to give a sense of
    depth without hiding fine detail.  Orbit, pan, and zoom all work with
    the mouse out-of-the-box.
    """
    verts = np.asarray(mesh.vertices).copy()
    faces = np.asarray(mesh.triangles).copy()

    # Force Z floor to exactly 0.0 — cut_mesh_at_z can leave a small residual
    verts[:, 2] -= verts[:, 2].min()

    x, y, z = verts[:, 0], verts[:, 1], verts[:, 2]
    i, j, k = faces[:, 0], faces[:, 1], faces[:, 2]

    # Axis ranges for a balanced aspect ratio
    x_range = (x.max() - x.min()) or 1.0
    y_range = (y.max() - y.min()) or 1.0
    z_range = (z.max() - z.min()) or 1.0
    xy_max  = max(x_range, y_range)

    fig = go.Figure(data=[go.Mesh3d(
        x=x, y=y, z=z,
        i=i, j=j, k=k,
        intensity=z,                  # colour by height
        colorscale="Viridis",
        colorbar=dict(title="Z (mm)", thickness=15, len=0.6),
        flatshading=False,
        lighting=dict(
            ambient=0.5,
            diffuse=0.8,
            specular=0.2,
            roughness=0.5,
            fresnel=0.1,
        ),
        lightposition=dict(x=1, y=1, z=2),
        showscale=True,
        name="Corrected Mesh",
    )])

    fig.update_layout(
        title=dict(
            text="Corrected Mesh – Interactive 3D Viewer (orbit / pan / zoom with mouse)",
            font=dict(size=14),
        ),
        scene=dict(
            xaxis_title="X (mm)",
            yaxis_title="Y (mm)",
            zaxis_title="Z (mm)",
            aspectmode="manual",
            aspectratio=dict(
                x=x_range / xy_max,
                y=y_range / xy_max,
                z=z_range / xy_max,
            ),
            camera=dict(
                eye=dict(x=1.5, y=-1.5, z=1.2),   # sensible default orbit angle
            ),
        ),
        margin=dict(l=0, r=0, t=50, b=0),
    )

    fig.write_html(path, include_plotlyjs="cdn", full_html=True)
    print("Saved HTML:", path)


# ============================================================
# PIPELINE STAGES
# ============================================================

def load_open3d_mesh(path: str) -> o3d.geometry.TriangleMesh:
    print("Loading:", path)
    mesh = o3d.io.read_triangle_mesh(path)

    if len(mesh.vertices) == 0 or len(mesh.triangles) == 0:
        raise RuntimeError("Input mesh is empty or invalid")

    print(f"Vertices: {len(mesh.vertices)} | Faces: {len(mesh.triangles)}")
    return mesh


def separate_object_and_floor(mesh, grid_res):
    object_mask = detect_floor_boundary(np.asarray(mesh.vertices), grid_res)
    if object_mask.sum() < 50:
        raise RuntimeError("Too few object vertices detected")
    return object_mask


def subtract_floor_plane(mesh, object_mask, shift):
    vertices = np.asarray(mesh.vertices)
    a, b, c = fit_plane(vertices[~object_mask])
    print(f"Floor plane: z = {a:.6f}x + {b:.6f}y + {c:.6f}")

    z_plane = a * vertices[:, 0] + b * vertices[:, 1] + (c - shift)
    vertices[:, 2] = np.maximum(0.0, vertices[:, 2] - z_plane)


def remove_floor_faces(mesh, object_mask):
    triangles = np.asarray(mesh.triangles)
    face_mask = np.all(~object_mask[triangles], axis=1)

    mesh.triangles = o3d.utility.Vector3iVector(triangles[face_mask])
    mesh.remove_unreferenced_vertices()
    mesh.remove_degenerate_triangles()
    mesh.remove_duplicated_triangles()
    mesh.remove_non_manifold_edges()
    mesh.compute_vertex_normals()


def normalize_and_trim_bottom(mesh):
    min_z = np.asarray(mesh.vertices)[:, 2].min()
    mesh.translate((0, 0, -min_z))

    vertices = np.asarray(mesh.vertices)
    triangles = np.asarray(mesh.triangles)

    edges = []
    for tri in triangles:
        edges.extend([
            tuple(sorted((tri[0], tri[1]))),
            tuple(sorted((tri[1], tri[2]))),
            tuple(sorted((tri[2], tri[0])))
        ])

    boundary_edges = [e for e, c in Counter(edges).items() if c == 1]
    if not boundary_edges:
        raise RuntimeError("No boundary edges found")

    boundary_vertices = np.unique(boundary_edges)
    max_z = vertices[boundary_vertices, 2].max()
    min_z = np.asarray(mesh.vertices)[:, 2].min()
    mesh.translate((0, 0, -min_z))

    return cut_mesh_at_z(mesh, max_z)


def save_corrected_ply(mesh, path):
    o3d.io.write_triangle_mesh(path, mesh)
    print("Saved PLY:", path)


def cap_and_export_stl(ply_path, stl_path):
    o3d_mesh = o3d.io.read_triangle_mesh(ply_path)
    o3d_mesh.compute_vertex_normals()

    tm = trimesh.Trimesh(
        vertices=np.asarray(o3d_mesh.vertices),
        faces=np.asarray(o3d_mesh.triangles),
        process=False
    )

    print(f"Watertight before capping: {tm.is_watertight}")
    closed = cap_open_bottom(tm)
    print(f"Watertight after  capping: {closed.is_watertight}")

    closed.export(stl_path)
    print("Saved STL:", stl_path)


# ============================================================
# MAIN
# ============================================================

def main():
    mesh = load_open3d_mesh(INPUT_PLY)

    object_mask = separate_object_and_floor(mesh, GRID_RES)

    subtract_floor_plane(mesh, object_mask, SHIFT)

    remove_floor_faces(mesh, object_mask)

    mesh = normalize_and_trim_bottom(mesh)

    save_corrected_ply(mesh, OUTPUT_PLY)

    cap_and_export_stl(OUTPUT_PLY, OUTPUT_STL)

    save_mesh_3d_html(mesh, OUTPUT_HTML)


if __name__ == "__main__":
    main()
